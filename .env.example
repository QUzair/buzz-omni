# Local Buzz + Omnigent platform configuration.
# `npm run setup` copies this file to ignored, mode-0600 `.env` once.

# Provider for all generated Omnigent agent profiles: copilot or gemini.
MODEL_PROVIDER=copilot

# Copy ONLY the public key from Buzz → Settings → Profile → Identity.
# A first-run client needs this to be enrolled in the relay and private channels.
BUZZ_DESKTOP_PUBKEY=

# Open the installed native Buzz Desktop app after the platform is ready.
OPEN_BUZZ_DESKTOP=true

# Required only for MODEL_PROVIDER=gemini. Use a newly issued key.
# Never commit `.env` or reuse a key that has been exposed.
GEMINI_API_KEY=

# Optional bridge safety limits.
BRIDGE_MAX_PROMPT_BYTES=131072
BRIDGE_TURN_TIMEOUT_MS=900000
