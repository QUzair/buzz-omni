# Non-secret values copied into the Buzz custom harness environment.
OMNIGENT_BASE_URL=https://your-omnigent.example
OMNIGENT_AGENT_ID=ag_replace_me
OMNIGENT_SANDBOX_PROVIDER=daytona

# Optional: clone a repository into each managed sandbox.
# OMNIGENT_WORKSPACE_URL=https://github.com/your-org/your-repo.git#main

# Optional: overrides the JWT stored by `omnigent login`.
# Never put a real token in this committed file.
# OMNIGENT_API_TOKEN=

# Operational limits.
BRIDGE_MAX_PROMPT_BYTES=131072
BRIDGE_TURN_TIMEOUT_MS=900000
